{
  "name": "pi-quote",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Quote agent messages and structurally selected Markdown from Pi's existing transcript.",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "quote",
    "markdown"
  ],
  "files": [
    "index.ts",
    "rendering.ts",
    "selection.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "diff": "8.0.4",
    "marked": "18.0.11"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "jiti": "2.7.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
